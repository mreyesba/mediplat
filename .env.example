# Copy this file to `.env` (repo root) and fill in real values. `.env` is
# gitignored — never commit it. Each developer/environment generates their own
# SECRET_KEY; it does not need to match anyone else's.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local Postgres container (docker-compose.yml). Values are only used
# locally between your machine and the container — pick anything.
POSTGRES_USER=mediplat
POSTGRES_PASSWORD=
POSTGRES_DB=mediplat

# Connection string the app uses. Should point at the container above —
# keep the user/password/db in sync with the POSTGRES_* values.
# Use 127.0.0.1, not localhost: on Windows, resolving/connecting to
# "localhost" can stall for well over a minute (IPv6-first resolution
# falling back to IPv4) even though the container is listening instantly.
DATABASE_URL=postgresql+psycopg://mediplat:<POSTGRES_PASSWORD>@127.0.0.1:5432/mediplat

# Off by default. Set to True locally to log every SQL statement SQLAlchemy
# runs — useful for debugging queries, noisy otherwise.
DEBUG=False

# Second local Postgres container (docker-compose.yml), with its own volume
# and port — keeps the backend test suite from touching dev data. Values are
# only used locally between your machine and the container — pick anything.
POSTGRES_TEST_USER=mediplat
POSTGRES_TEST_PASSWORD=
POSTGRES_TEST_DB=mediplat_test

# Connection string the test suite uses. Should point at the container
# above — keep the user/password/db in sync with the POSTGRES_TEST_* values.
# Use 127.0.0.1, not localhost (see note above).
TEST_DATABASE_URL=postgresql+psycopg://mediplat:<POSTGRES_TEST_PASSWORD>@127.0.0.1:5433/mediplat_test
