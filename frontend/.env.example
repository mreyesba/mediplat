# Leave unset for local dev — apiConfig.ts falls back to relative paths,
# which Vite's dev proxy (vite.config.ts) forwards to the local backend.
# Production builds (see .github/workflows/deploy-pages.yml) set this to the
# deployed backend's absolute URL, since there's no dev proxy in production.
# VITE_API_URL=https://mediplat.onrender.com
